# Copy this file to .env and keep .env private. This stack is for dev/preview use.

# ── Hetzner ──
HETZNER_SERVER_NAME=supabase-dev
HETZNER_SERVER_TYPE=cax31
HETZNER_LOCATION=hil          # hil = Hillsboro, OR | ash = Ashburn, VA
HETZNER_SSH_KEY_NAME=default   # Name of SSH key in Hetzner console (or "none" to skip)
SSH_KEY_PATH=~/.ssh/id_ed25519 # Local path to the private key matching the Hetzner SSH key

# ── Domain ──
# Your projects will be accessible at: <project>.dev.example.com
DEV_DOMAIN=dev.example.com

# ── DNS Provider for Let's Encrypt wildcard cert ──
# Options: route53, dnsimple
DNS_PROVIDER=dnsimple

# For route53: ensure AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set
# For dnsimple: set DNSIMPLE_TOKEN below
DNSIMPLE_TOKEN=

# ── Let's Encrypt ──
LETSENCRYPT_EMAIL=you@example.com

# ── Supabase Defaults ──
# Base port for first project. Each project gets a block of 20 ports.
# project 1: 54320-54339, project 2: 54340-54359, etc.
SUPABASE_PORT_BASE=54320
SUPABASE_PORT_BLOCK=20

# Max stacks running at once; beyond this, the least-recently-active stack is hibernated.
# MAX_RUNNING_STACKS=12
